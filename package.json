{
  "name": "alltools-desktop",
  "version": "0.1.0",
  "description": "Offline-first desktop utility platform with on-demand Python plugins",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "rm -rf dist-electron && electron-vite build",
    "start": "pnpm build && electron .",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "test": "tsc --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test:manifest": "tsx src/shared/manifest.test.ts",
    "test:supervisor": "python3 runtime/test_supervisor.py",
    "dist:linux": "pnpm build && electron-builder --linux AppImage --x64",
    "dist:win": "pnpm build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.alltools.desktop",
    "productName": "AllTools",
    "files": [
      "dist-electron/**/*",
      "runtime/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
